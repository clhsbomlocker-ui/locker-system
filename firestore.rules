rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // but restrict write access to authenticated users only
    
    // Public read access for lockers - students can see locker availability
    match /lockers/{lockerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Public read access for assignments - students can see who has which locker
    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Public read access for responses - students can see occupant information
    match /responses/{responseId} {
      allow read: if true;
      allow create: if true; // Students can still register
      allow update, delete: if request.auth != null;
    }
    
    // Public access for student registration forms
    match /forms/{formId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Admin-only access for other collections
    match /signatures/{signatureId} {
      allow read, write: if request.auth != null;
    }
    
    match /students/{studentId} {
      allow read, write: if request.auth != null;
    }
    
    // Now only specific collections require authentication for write operations
  }
}
